---
import { site } from "@/data/site";
import { categories } from "@/data/posts";

interface Props {
  active?: string;
}
const { active = "all" } = Astro.props;
const filters = ["all", ...categories.map((c) => c.toLowerCase())] as const;
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-rule)] bg-[var(--color-ink)]/85 backdrop-blur-md"
>
  <div class="relative mx-auto w-full max-w-6xl px-5 wide:px-10">
    <!-- Top thin amber bar -->
    <div class="absolute left-0 right-0 top-0 h-[2px]">
      <div class="h-full w-1/3 bg-[var(--color-amber)] amber-flicker"></div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 py-4">
      <a href="/" class="no-line group flex items-baseline gap-3">
        <span class="mono text-[var(--color-amber)] text-xs tracking-[0.28em] uppercase">
          ▮ Field Notes
        </span>
        <span class="mono hidden sm:inline text-[var(--color-paper-dim)] text-[0.65rem] tracking-[0.22em] uppercase">
          {site.title}
        </span>
      </a>

      <nav class="flex items-center gap-2 flex-wrap">
        {filters.map((f) => (
          <a
            href={f === "all" ? "/" : `/?cat=${f}`}
            class:list={["stamp no-line", { "is-active": active === f }]}
            data-filter={f}
          >
            {f}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>
